---
/**
 * Envoltorio de las 6 páginas de comprobante.
 * Evita repetir Layout + Header + Footer + schema en cada archivo.
 *
 * Schema por página: FAQPage (las 4 preguntas de esa página) + BreadcrumbList +
 * Service. El brief pedía además `Offer` con precio: NO se incluye a propósito,
 * porque los precios son ficticios y publicarlos como datos estructurados los
 * expone en los resultados enriquecidos de Google. Añadir el Offer cuando el
 * dueño confirme los precios reales.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Comprobante from '../components/Comprobante.astro';
import { comprobantes, temas, type Slug } from '../data/comprobantes';

export interface Props {
  slug: Slug;
}

const { slug } = Astro.props;
const c = comprobantes[slug];
const t = temas[slug];
const base = 'https://formatosintergraficos.pe';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Comprobantes', item: `${base}/#comprobantes` },
      { '@type': 'ListItem', position: 3, name: c.nombre, item: `${base}${c.url}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Impresión de ${c.nombre.toLowerCase()} autorizadas SUNAT`,
    serviceType: 'Impresión de comprobantes de pago',
    provider: { '@type': 'LocalBusiness', name: 'Formatos Intergráficos', '@id': base },
    areaServed: [
      { '@type': 'City', name: 'Lima' },
      { '@type': 'Country', name: 'Perú' },
    ],
    description: c.description,
  },
];
---

<Layout title={c.title} description={c.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <div class="fi-site" style={`--cp-accent:${t.accent}`}>
    <Header active="comprobantes" />
    <main>
      <Comprobante slug={slug} />
    </main>
    <Footer />
  </div>
</Layout>
