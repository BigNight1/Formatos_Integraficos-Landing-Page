---
/**
 * Footer unificado del rediseño v2.
 * Fuente: design-refs/diseno/Footer.dc.html (el componente completo, no el
 * footer reducido que la Home traía embebido).
 *
 * Resuelto: una imprenta no tiene un único número de autorización (SUNAT emite
 * uno por cada pedido de impresión del cliente), así que el pie dice "Imprenta
 * inscrita en SUNAT" junto al RUC y enlaza a la consulta de RUC de SUNAT.
 *
 * ⚠️ FICTICIO pendiente de reemplazo (ver formatos-intergraficos-rediseno-seo.md):
 *   - "Garantía: si hay un error nuestro, reimprimimos sin costo" → solo si es real.
 *   - "Pago contra entrega para clientes recurrentes" → condiciones reales.
 */
import { WHATSAPP } from '../data/home';

const columnas = [
  {
    titulo: 'Comprobantes',
    enlaces: [
      { label: 'Boletas de venta', url: '/boletas-de-venta' },
      { label: 'Facturas', url: '/facturas' },
      { label: 'Guías de remisión', url: '/guias-de-remision' },
      { label: 'Notas de crédito y débito', url: '/notas-de-credito-debito' },
      { label: 'Liquidaciones de compra', url: '/liquidaciones-de-compra' },
      { label: 'Retención y percepción', url: '/retencion-percepcion' },
    ],
  },
  {
    titulo: 'Otros formatos',
    enlaces: [
      { label: 'Formatos continuos', url: '/servicios/formatos-continuos' },
      { label: 'Proformas y documentos', url: '/servicios/documentos-administrativos' },
      { label: 'Vouchers POS', url: '/servicios/vouchers-pos' },
      { label: 'Letras de cambio', url: '/servicios/letras-de-cambio' },
      { label: 'Recibos por honorarios', url: '/servicios/recibos-por-honorarios' },
      { label: 'Documentos aduaneros', url: '/servicios/documentos-aduaneros' },
    ],
  },
  {
    titulo: 'Empresa',
    enlaces: [
      { label: 'Nosotros', url: '/nosotros' },
      { label: 'Precios', url: '/precios' },
      { label: 'Autorización SUNAT', url: '/autorizado-sunat' },
      { label: 'Galería', url: '/galeria' },
      { label: 'Guías', url: '/blog' },
    ],
  },
];

const anio = new Date().getFullYear();
---

<footer class="fi-footer">
  <!-- Barra de garantías -->
  <div class="fi-footer__bar">
    <div class="fi-footer__barinner">
      <div class="fi-footer__sells">
        <span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
          <span><strong>Garantía:</strong> si hay un error nuestro, reimprimimos sin costo</span>
        </span>
        <span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="6" width="18" height="12" rx="2"></rect>
            <path d="M3 10h18"></path>
          </svg>
          <span><strong>Pago contra entrega</strong> para clientes recurrentes</span>
        </span>
      </div>
      <a class="fi-footer__cta" href={WHATSAPP} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp</a>
    </div>
  </div>

  <div class="fi-footer__main">
    <div class="fi-footer__cols">
      <div class="fi-footer__brand">
        <span class="fi-footer__logo">Formatos Intergráficos</span>
        <p class="fi-footer__tagline">
          Imprenta autorizada SUNAT en Lima con más de 20 años imprimiendo comprobantes de pago y
          formatos continuos.
        </p>
        <p class="fi-footer__legal">
          RUC 20503580030<br />
          Imprenta inscrita en SUNAT ·
          <a href="https://e-consultaruc.sunat.gob.pe/cl-ti-itmrconsruc/FrameCriterioBusquedaWeb.jsp" target="_blank" rel="noopener noreferrer">verificar en SUNAT</a>
        </p>
      </div>

      {
        columnas.map((col) => (
          <nav class="fi-footer__col" aria-label={col.titulo}>
            <strong>{col.titulo}</strong>
            {col.enlaces.map((e) => (
              <a href={e.url}>{e.label}</a>
            ))}
          </nav>
        ))
      }

      <address class="fi-footer__col fi-footer__address">
        <strong>Visítanos</strong>
        <span>
          Pasaje 8 de Octubre 252<br />
          Parque Interno Hogar Policial<br />
          Villa María del Triunfo, Lima
        </span>
        <a href="tel:+51910500706">910 500 706</a>
        <span class="fi-footer__horario">Lun a Sáb 8:00 – 20:00</span>
      </address>
    </div>

    <p class="fi-footer__copy">© {anio} Formatos Intergráficos · Imprenta autorizada SUNAT en Lima</p>
  </div>
</footer>

<style>
  .fi-footer {
    background: var(--fi-carbon);
    color: var(--fi-texto-claro);
    font-family: var(--fi-sans);
    /* Lo usan también páginas que no van dentro de .fi-site: fija su línea base. */
    line-height: normal;
    box-sizing: border-box;
  }

  .fi-footer__bar {
    background: var(--fi-rojo);
    padding: 28px clamp(16px, 4vw, 64px);
  }
  .fi-footer__barinner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .fi-footer__sells {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    font-size: 15px;
    color: #ffffff;
  }
  .fi-footer__sells > span {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .fi-footer__cta {
    padding: 14px 22px;
    background: var(--fi-carbon);
    color: var(--fi-texto-claro);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
  }
  .fi-footer__cta:hover {
    background: #ffffff;
    color: var(--fi-carbon);
  }

  .fi-footer__main {
    padding: 56px clamp(16px, 4vw, 64px) 36px;
  }
  .fi-footer__cols {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: space-between;
  }

  .fi-footer__brand {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 380px;
  }
  .fi-footer__logo {
    font-family: var(--fi-display);
    font-weight: 900;
    font-size: 26px;
    text-transform: uppercase;
  }
  .fi-footer__tagline {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fi-texto-apagado);
  }
  .fi-footer__legal {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
  }
  .fi-footer__legal a {
    text-decoration: underline;
  }

  .fi-footer__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    font-style: normal;
  }
  .fi-footer__col strong {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fi-texto-apagado);
    font-weight: 400;
  }
  .fi-footer__col a {
    text-decoration: none;
  }
  .fi-footer__col a:hover {
    color: var(--fi-rosa);
  }
  .fi-footer__address {
    line-height: 1.6;
  }
  .fi-footer__horario {
    color: var(--fi-texto-apagado);
  }

  .fi-footer__copy {
    max-width: 1280px;
    margin: 40px auto 0;
    padding-top: 20px;
    border-top: 1px solid var(--fi-borde-oscuro);
    font-size: 13px;
    color: var(--fi-texto-apagado-2);
  }

  @media (max-width: 1023px) {
    .fi-footer__sells {
      gap: 16px;
    }
    .fi-footer__cta {
      width: 100%;
      text-align: center;
    }
  }
</style>
