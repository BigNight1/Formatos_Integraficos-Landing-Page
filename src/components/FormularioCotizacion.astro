---
/**
 * Sección Cotizar (formulario) · rediseño v2 — design-refs/diseno/Home.dc.html
 *
 * Se conserva del formulario anterior la lógica de negocio: el envío no va a un
 * backend, arma un mensaje preformateado y abre WhatsApp. Se añaden los eventos
 * GA4 que pedía el brief (clic en WhatsApp y envío del formulario).
 *
 * Campos: los del diseño (sin email). Obligatorios solo nombre y WhatsApp, para
 * no frenar la conversión; RUC y cantidad quedan opcionales.
 * Cantidad en MILLARES (el diseño decía "juegos").
 */
import { WHATSAPP, TELEFONO } from '../data/home';
---

<section class="fi-section fi-cotizar" id="cotizar">
  <div class="fi-deco">
    <div class="fi-cotizar__circle" aria-hidden="true"></div>
  </div>

  <div class="fi-wrap fi-cotizar__inner">
    <div class="fi-cotizar__copy">
      <h2 class="fi-cotizar__title">Cotiza gratis<br />en minutos</h2>
      <p class="fi-cotizar__text">
        Envíanos tu RUC y el comprobante que necesitas. Te respondemos con precio y prueba de diseño
        el mismo día.
      </p>
      <a
        class="fi-cotizar__wa"
        href={WHATSAPP}
        target="_blank"
        rel="noopener noreferrer"
        data-wa="cotizar-seccion"
      >
        Prefiero WhatsApp · 910 500 706
      </a>
    </div>

    <form class="fi-cotizar__form fi-form" id="cotizacionForm" novalidate>
      <label class="fi-field">
        <span>Nombre o razón social</span>
        <input type="text" name="nombre" autocomplete="organization" required />
      </label>

      <label class="fi-field">
        <span>RUC</span>
        <input type="text" name="ruc" inputmode="numeric" maxlength="11" pattern="[0-9]{11}" />
      </label>

      <label class="fi-field">
        <span>WhatsApp</span>
        <input type="tel" name="whatsapp" autocomplete="tel" required />
      </label>

      <label class="fi-field">
        <span>Comprobante</span>
        <select name="tipo">
          <option>Boletas de venta</option>
          <option>Facturas</option>
          <option>Guías de remisión</option>
          <option>Notas de crédito / débito</option>
          <option>Vouchers POS</option>
          <option>Otro formato</option>
        </select>
      </label>

      <label class="fi-field fi-field--full">
        <span>Cantidad aproximada (millares)</span>
        <input type="number" name="cantidad" min="1" step="1" inputmode="numeric" />
      </label>

      <button class="fi-cotizar__submit" type="submit">Enviar cotización</button>
      <p class="fi-cotizar__aviso" id="cotizar-aviso" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const WHATSAPP_NUM = '51910500706';

  const val = (form: HTMLFormElement, name: string) =>
    ((form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '').trim();

  const form = document.getElementById('cotizacionForm') as HTMLFormElement | null;
  const aviso = document.getElementById('cotizar-aviso');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nombre = val(form, 'nombre');
      const whatsapp = val(form, 'whatsapp');

      // Validación propia: el diseño no traía ninguna.
      if (!nombre || !whatsapp) {
        if (aviso) aviso.textContent = 'Completa tu nombre y tu WhatsApp para poder cotizarte.';
        (form.elements.namedItem(nombre ? 'whatsapp' : 'nombre') as HTMLElement | null)?.focus();
        return;
      }
      if (aviso) aviso.textContent = '';

      const tipoSelect = form.elements.namedItem('tipo') as HTMLSelectElement | null;
      const tipo = tipoSelect ? tipoSelect.options[tipoSelect.selectedIndex].text : '';
      const cantidad = val(form, 'cantidad');
      const ruc = val(form, 'ruc');

      const lineas = [
        '*Nueva cotización desde la web*',
        '',
        `*Nombre:* ${nombre}`,
        ruc ? `*RUC:* ${ruc}` : null,
        `*WhatsApp:* ${whatsapp}`,
        `*Comprobante:* ${tipo}`,
        cantidad ? `*Cantidad:* ${cantidad} millares` : null,
      ].filter((l): l is string => l !== null);

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'generate_lead', {
          event_category: 'Cotizacion',
          event_label: tipo,
          value: 1,
        });
      }

      window.open(
        `https://wa.me/${WHATSAPP_NUM}?text=${encodeURIComponent(lineas.join('\n'))}`,
        '_blank',
        'noopener'
      );
      form.reset();
    });
  }

  // Un evento GA4 por cada clic en un enlace de WhatsApp (lo pedía el brief).
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement | null)?.closest?.('a[href*="wa.me"]');
    if (!a) return;
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'click_whatsapp', {
        event_category: 'Contacto',
        event_label: a.getAttribute('data-wa') ?? 'otro',
      });
    }
  });
</script>

<style>
  .fi-cotizar {
    position: relative;
    overflow: hidden;
    /* Fondo propio. Los textos de este bloque son claros porque el diseño los
       pensó sobre oscuro. En la Home el padre ya es carbón, así que esto no
       cambia nada; en /contacto (página del diseño viejo, con fondo blanco) el
       texto quedaba INVISIBLE: claro sobre blanco. Con fondo propio funciona en
       cualquier sitio donde se use. */
    background: var(--fi-carbon);
    color: var(--fi-texto-claro);
  }
  .fi-cotizar__circle {
    position: absolute;
    right: -200px;
    bottom: -200px;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    background: var(--fi-rojo);
  }
  .fi-cotizar__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    position: relative;
  }
  .fi-cotizar__copy {
    flex: 1 1 360px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .fi-cotizar__title {
    margin: 0;
    font-family: var(--fi-display);
    font-weight: 900;
    font-size: clamp(48px, 6vw, 96px);
    line-height: 0.88;
    text-transform: uppercase;
  }
  .fi-cotizar__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--fi-texto-claro-2);
    max-width: 420px;
  }
  .fi-cotizar__wa {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 24px;
    border: 2px solid var(--fi-papel);
    font-weight: 700;
    text-decoration: none;
    color: var(--fi-papel);
  }
  .fi-cotizar__wa:hover {
    background: var(--fi-papel);
    color: var(--fi-carbon);
  }

  .fi-cotizar__form {
    flex: 1 1 460px;
    background: var(--fi-papel);
    color: var(--fi-texto-oscuro);
    padding: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 18px;
    box-sizing: border-box;
    align-content: start;
  }
  .fi-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
  }
  .fi-field--full {
    grid-column: 1 / -1;
  }
  .fi-field input,
  .fi-field select {
    /* content-box como el diseño: su height:48px no incluía los 2px de borde,
       así que cada campo mide 50px y cada fila del formulario 73px (no 71). */
    box-sizing: content-box;
    height: 48px;
    padding: 0 14px;
    border: 1px solid var(--fi-input-borde);
    background: #ffffff;
    font: inherit;
    font-weight: 400;
    font-size: 15px;
    color: var(--fi-texto-oscuro);
  }
  .fi-cotizar__submit {
    grid-column: 1 / -1;
    height: 56px;
    border: 0;
    background: var(--fi-carbon);
    color: var(--fi-papel);
    font: inherit;
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .fi-cotizar__submit:hover {
    background: var(--fi-rojo);
  }
  .fi-cotizar__aviso {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--fi-rojo-oscuro);
  }
  .fi-cotizar__aviso:empty {
    display: none;
  }

  /* --- Móvil (añadido) --- */
  @media (max-width: 767px) {
    .fi-cotizar__inner {
      gap: 36px;
    }
    .fi-cotizar__form {
      padding: 24px 20px;
      grid-template-columns: 1fr;
    }
    .fi-cotizar__circle {
      right: -300px;
      bottom: -300px;
      width: 520px;
      height: 520px;
      opacity: 0.85;
    }
    .fi-cotizar__wa {
      align-self: stretch;
      text-align: center;
      justify-content: center;
    }
  }
</style>
