---
/**
 * Header unificado del rediseño v2.
 * Fuente: design-refs/diseno/Header.dc.html
 *
 * Decisión del cliente (2026-10-08): una sola navegación para las 13 páginas.
 * Se usa "Autorización SUNAT" (no "Requisitos SUNAT") y se elimina el <header>
 * propio que la Home traía embebido.
 *
 * El diseño no tenía versión móvil (0 media queries en los 12 archivos): el
 * menú desplegable de móvil es añadido aquí.
 *
 * `active` es opcional para no romper las páginas que aún no se rediseñan.
 */
import { WHATSAPP } from '../data/home';

export interface Props {
  active?: 'inicio' | 'comprobantes' | 'precios' | 'sunat' | 'blog' | 'nosotros';
}

const { active = 'inicio' } = Astro.props;

const items = [
  { id: 'comprobantes', label: 'Comprobantes', url: '/#comprobantes' },
  { id: 'precios', label: 'Precios', url: '/precios' },
  { id: 'sunat', label: 'Autorización SUNAT', url: '/autorizado-sunat' },
  { id: 'blog', label: 'Guías', url: '/blog' },
  { id: 'nosotros', label: 'Nosotros', url: '/nosotros' },
] as const;
---

<header class="fi-header">
  <div class="fi-header__inner">
    <a class="fi-header__logo" href="/">
      <img
        src="/LogoFormatos.webp"
        alt="Logo de Formatos Intergráficos, imprenta autorizada SUNAT en Lima"
        width="42"
        height="38"
        fetchpriority="high"
      />
      <span>Formatos Intergráficos</span>
    </a>

    <button
      class="fi-header__toggle"
      type="button"
      id="fi-nav-toggle"
      aria-expanded="false"
      aria-controls="fi-nav"
      aria-label="Abrir menú"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
      </svg>
    </button>

    <nav class="fi-header__nav" id="fi-nav" aria-label="Principal">
      {
        items.map((i) => (
          <a
            href={i.url}
            class:list={[{ 'is-active': i.id === active }]}
            aria-current={i.id === active ? 'page' : undefined}
          >
            {i.label}
          </a>
        ))
      }
      <a class="fi-header__cta" href={WHATSAPP} target="_blank" rel="noopener noreferrer">Cotizar</a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('fi-nav-toggle');
    const nav = document.getElementById('fi-nav');
    if (!toggle || !nav) return;

    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });

    nav.addEventListener('click', (e) => {
      if (e.target instanceof HTMLAnchorElement && nav.classList.contains('is-open')) {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>

<style>
  .fi-header {
    background: var(--fi-carbon);
    color: var(--fi-texto-claro);
    font-family: var(--fi-sans);
    /* El header lo usan también páginas que no van dentro de .fi-site, así que
       fija aquí su propia línea base (el diseño no tenía reset: normal). */
    line-height: normal;
    padding: 24px clamp(16px, 4vw, 64px);
    border-bottom: 1px solid var(--fi-borde-oscuro);
    box-sizing: border-box;
    position: relative;
    z-index: 20;
  }

  .fi-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .fi-header__logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--fi-texto-claro);
  }
  .fi-header__logo img {
    width: 42px;
    height: 38px;
    object-fit: contain;
  }
  .fi-header__logo span {
    font-family: var(--fi-display);
    font-weight: 900;
    font-size: 22px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fi-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .fi-header__nav a {
    text-decoration: none;
    padding: 12px 0;
    color: var(--fi-texto-claro-2);
  }
  .fi-header__nav a:hover {
    color: #ffffff;
  }
  .fi-header__nav a.is-active {
    color: #ffffff;
    border-bottom: 2px solid var(--fi-rojo);
    font-weight: 700;
  }

  /* OJO con la especificidad: `.fi-header__nav a` (0,1,1) gana a `.fi-header__cta`
     (0,1,0), así que el padding:12px 18px del diseño se perdía y el botón quedaba
     en 68px con el texto pegado a los bordes. Con el selector de abajo (0,2,0)
     el botón recupera sus 104px. */
  .fi-header__nav .fi-header__cta {
    padding: 12px 18px;
    background: var(--fi-rojo);
    color: #ffffff;
    font-weight: 700;
  }
  .fi-header__nav .fi-header__cta:hover {
    background: var(--fi-rojo-oscuro);
    color: #ffffff;
  }

  .fi-header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--fi-texto-claro);
    cursor: pointer;
  }

  /* --- Móvil / tablet: añadido, el diseño no lo traía --- */
  @media (max-width: 1023px) {
    .fi-header__toggle {
      display: flex;
    }
    .fi-header__nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .fi-header__nav.is-open {
      display: flex;
    }
    .fi-header__nav a {
      padding: 16px 0;
      border-top: 1px solid var(--fi-borde-oscuro);
    }
    .fi-header__nav a.is-active {
      border-bottom: 0;
    }
    .fi-header__nav .fi-header__cta {
      text-align: center;
      margin: 16px 0 4px;
      padding: 14px 18px;
      border-top: 0;
    }
  }
</style>
