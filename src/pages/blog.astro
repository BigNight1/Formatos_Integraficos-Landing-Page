---
/**
 * /blog · rediseño v2
 * Fuente: design-refs/diseno/Blog.dc.html
 *
 * Nota: esta página es de fondo PAPEL con hero oscuro (no carbón como el resto),
 * igual que en el diseño.
 *
 * ⚠️ 5 de los 6 posts todavía no tienen artículo: se muestran sin enlace para no
 *    generar 404. Las categorías se muestran como etiquetas, sin enlace.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { destacada, posts, categorias } from '../data/blog';

const base = 'https://formatosintergraficos.pe';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Guías sobre comprobantes de pago y SUNAT',
    url: `${base}/blog`,
    blogPost: posts
      .filter((p) => p.listo)
      .map((p) => ({ '@type': 'BlogPosting', headline: p.t, url: `${base}${p.url}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Guías', item: `${base}/blog` },
    ],
  },
];
---

<Layout
  title="Guías de Comprobantes de Pago y SUNAT"
  description="Guías prácticas sobre boletas, facturas y guías de remisión: medidas, papel autocopiativo, pie de imprenta y autorización en SUNAT SOL."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <div class="fi-site bl">
    <Header active="blog" />

    <main>
      <!-- HERO -->
      <section class="bl-hero">
        <div class="bl-wrap bl-hero__inner">
          <nav class="bl-bc" aria-label="Ruta de navegación">
            <a href="/">Inicio</a> <span aria-hidden="true">›</span>
            <span aria-current="page">Guías</span>
          </nav>
          <h1 class="bl-h1">Guías sobre comprobantes de pago y SUNAT</h1>
          <p class="bl-hero__lead">
            Respuestas prácticas para negocios que emiten boletas, facturas y guías. Escritas por la
            imprenta, revisadas por un contador.
          </p>
          <ul class="bl-cats">
            {
              categorias.map((cat) =>
                cat.url ? (
                  <li>
                    <a href={cat.url} aria-current="page" class="is-active">
                      {cat.label}
                    </a>
                  </li>
                ) : (
                  <li>
                    <span class="bl-cat">{cat.label}</span>
                  </li>
                )
              )
            }
          </ul>
        </div>
      </section>

      <!-- POSTS -->
      <section class="bl-posts">
        <div class="bl-wrap bl-posts__inner">
          <!-- Destacada -->
          <a class="bl-feat" href={destacada.url}>
            <div class="bl-feat__panel">
              <div class="bl-feat__circle" aria-hidden="true"></div>
              <span class="bl-feat__sigla">Guía<br />SUNAT</span>
            </div>
            <div class="bl-feat__body">
              <span class="bl-tag">{destacada.tag}</span>
              <h2 class="bl-feat__title">{destacada.t}</h2>
              <p class="bl-feat__desc">{destacada.d}</p>
              <span class="bl-meta">
                {destacada.min} min · {destacada.fecha}
              </span>
            </div>
          </a>

          <!-- Listado -->
          <div class="bl-grid">
            {
              posts.map((p) =>
                p.listo ? (
                  <a class="bl-post" href={p.url}>
                    <span class="bl-tag">{p.tag}</span>
                    <h2 class="bl-post__title">{p.t}</h2>
                    <p class="bl-post__desc">{p.d}</p>
                    <span class="bl-meta">{p.min} min de lectura</span>
                  </a>
                ) : (
                  <article class="bl-post bl-post--pendiente">
                    <span class="bl-tag">{p.tag}</span>
                    <h2 class="bl-post__title">{p.t}</h2>
                    <p class="bl-post__desc">{p.d}</p>
                    <span class="bl-pendiente">En preparación</span>
                  </article>
                )
              )
            }
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .bl {
    background: var(--fi-papel);
    color: var(--fi-texto-oscuro);
  }
  .bl-wrap {
    max-width: 1280px;
    margin: 0 auto;
  }

  /* HERO */
  .bl-hero {
    background: var(--fi-carbon);
    color: var(--fi-texto-claro);
    padding: 40px clamp(16px, 4vw, 64px) 72px;
  }
  .bl-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .bl-bc {
    font-size: 13px;
    color: var(--fi-texto-apagado);
  }
  .bl-bc a {
    text-decoration: none;
  }
  .bl-bc span[aria-current] {
    color: var(--fi-texto-claro);
  }
  .bl-h1 {
    margin: 0;
    font-family: var(--fi-display);
    font-weight: 900;
    font-size: clamp(48px, 6vw, 96px);
    line-height: 0.9;
    text-transform: uppercase;
    max-width: 900px;
  }
  .bl-hero__lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--fi-texto-claro-2);
    max-width: 660px;
  }
  .bl-cats {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bl-cats a,
  .bl-cat {
    display: inline-block;
    padding: 10px 16px;
    font-size: 14px;
    text-decoration: none;
  }
  .bl-cats a.is-active {
    background: var(--fi-papel);
    color: var(--fi-texto-oscuro);
    font-weight: 700;
  }
  .bl-cat {
    border: 1px solid #5a5354;
    color: var(--fi-texto-apagado);
  }

  /* POSTS */
  .bl-posts {
    padding: 72px clamp(16px, 4vw, 64px) 104px;
  }
  .bl-posts__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .bl-feat {
    display: flex;
    flex-wrap: wrap;
    background: #ffffff;
    border: 1px solid var(--fi-borde-claro-2);
    text-decoration: none;
    color: var(--fi-texto-oscuro);
  }
  .bl-feat:hover {
    color: var(--fi-texto-oscuro);
  }
  .bl-feat__panel {
    flex: 1 1 420px;
    min-height: 320px;
    background: var(--fi-rojo);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 32px;
    box-sizing: border-box;
  }
  .bl-feat__circle {
    position: absolute;
    right: -80px;
    top: -80px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: var(--fi-rojo-oscuro);
  }
  .bl-feat__sigla {
    position: relative;
    font-family: var(--fi-display);
    font-weight: 900;
    font-size: 88px;
    line-height: 0.85;
    color: #ffffff;
    text-transform: uppercase;
  }
  .bl-feat__body {
    flex: 1 1 420px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
  }
  .bl-tag {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fi-rojo-oscuro);
  }
  .bl-feat__title {
    margin: 0;
    font-size: 32px;
    line-height: 1.15;
    /* Tailwind resetea el font-weight de los títulos a inherit; el diseño
       dependía del 700 por defecto del navegador. */
    font-weight: 700;
  }
  .bl-feat__desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--fi-texto-oscuro-2);
  }
  .bl-meta {
    font-size: 14px;
    color: var(--fi-texto-oscuro-2);
  }

  .bl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .bl-post {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    background: #ffffff;
    border: 1px solid var(--fi-borde-claro-2);
    text-decoration: none;
    color: var(--fi-texto-oscuro);
    min-height: 240px;
    box-sizing: border-box;
    height: 100%;
  }
  .bl-post:hover {
    color: var(--fi-texto-oscuro);
  }
  .bl-post__title {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 700; /* ídem: el diseño usaba el 700 por defecto de <h2> */
  }
  .bl-post__desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--fi-texto-oscuro-2);
    flex: 1;
  }
  .bl-post--pendiente {
    background: #faf7f5;
  }
  .bl-pendiente {
    font-size: 13px;
    color: var(--fi-texto-apagado-2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  /* ================= MÓVIL (añadido) ================= */
  @media (max-width: 767px) {
    .bl-hero {
      padding: 32px 20px 56px;
    }
    .bl-h1 {
      font-size: clamp(34px, 10vw, 52px);
    }
    .bl-hero__lead {
      font-size: 16px;
    }
    .bl-posts {
      padding: 48px 20px 72px;
    }
    .bl-feat__panel {
      flex: 1 1 auto;
      min-height: 200px;
      padding: 24px;
    }
    .bl-feat__sigla {
      font-size: 56px;
    }
    .bl-feat__body {
      flex: 1 1 auto;
      padding: 24px;
    }
    .bl-feat__title {
      font-size: 24px;
    }
    .bl-grid {
      grid-template-columns: 1fr;
    }
    .bl-post {
      min-height: 0;
      padding: 22px;
    }
    .bl-cats a,
    .bl-cat {
      font-size: 13px;
      padding: 8px 13px;
    }
  }
</style>
