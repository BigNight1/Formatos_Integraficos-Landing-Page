---
/**
 * Home · rediseño v2 (estilo B "Círculo de tinta")
 * Fuente: design-refs/diseno/Home.dc.html — 13 secciones + header y footer.
 *
 * Title y meta description según el plan SEO del brief
 * (formatos-intergraficos-rediseno-seo.md).
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormularioCotizacion from '../components/FormularioCotizacion.astro';

import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import Comprobantes from '../components/home/Comprobantes.astro';
import Precios from '../components/home/Precios.astro';
import Proceso from '../components/home/Proceso.astro';
import Requisitos from '../components/home/Requisitos.astro';
import Especificaciones from '../components/home/Especificaciones.astro';
import Trabajos from '../components/home/Trabajos.astro';
import Testimonios from '../components/home/Testimonios.astro';
import Cobertura from '../components/home/Cobertura.astro';
import Faq from '../components/home/Faq.astro';
import Guias from '../components/home/Guias.astro';

import { faqs } from '../data/home';

// Schema FAQPage: las 10 preguntas que realmente se muestran en la página.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Imprenta Autorizada SUNAT en Lima | Boletas y Facturas"
  description="Boletas, facturas y guías de remisión en formato continuo, con tu logo y numeración SUNAT. Entrega en 24 h en Lima. Cotiza gratis."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <div class="fi-site">
    <Header active="inicio" />

    <main>
      <Hero />
      <TrustBar />
      <Comprobantes />
      <Precios />
      <Proceso />
      <Requisitos />
      <Especificaciones />
      <Trabajos />
      <Testimonios />
      <Cobertura />
      <Faq />
      <Guias />
      <FormularioCotizacion />
    </main>

    <Footer />
  </div>
</Layout>
