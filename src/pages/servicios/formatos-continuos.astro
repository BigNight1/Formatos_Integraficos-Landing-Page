---
/**
 * /servicios/formatos-continuos · rediseño v2
 *
 * NO viene del canvas: el diseño no traía esta página. Se construye con el
 * sistema del rediseño (tokens, Header y Footer compartidos, .fi-wrap 1280,
 * .fi-h2, .fi-deco) y con **carácter propio**, distinto del resto:
 *
 *   · RIEL PERFORADO en el borde izquierdo del hero, como el papel continuo.
 *   · HERO partido: texto a la izquierda, maqueta de la guía a la derecha.
 *   · TABLA TÉCNICA de medidas con números en monoespaciada.
 *   · Chips de sector en la sección oscura.
 *
 * Datos de producto reales, tomados de la página anterior y de `src/data/precios.ts`
 * (medidas y copias coinciden con /precios: 9½"×5½", 9½"×11", Original + 1/2/3).
 *
 * ⚠️ El texto legal de contingencia ("Comprobante de pago emitido en contingencia")
 *    es la leyenda que SUNAT exige; conviene que lo revise un contador.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Documento from '../../components/Documento.astro';
import { WHATSAPP } from '../../data/home';

const base = 'https://formatosintergraficos.pe';

const medidas = [
  {
    formato: 'Boleta continua',
    medida: '9½" × 5½"',
    copias: 'Original + 1',
    uso: 'Contingencia y series de bajo volumen',
  },
  {
    formato: 'Factura continua',
    medida: '9½" × 11"',
    copias: 'Original + 2',
    uso: 'Facturación física y control de despacho',
  },
  {
    formato: 'Guía continua',
    medida: '9½" × 11"',
    copias: 'Original + 3',
    uso: 'Traslado: remitente, transportista y SUNAT',
  },
];

const especificaciones = [
  { t: 'Perforación lateral', d: 'Arrastre por tractor de agujas, a ambos lados de la hoja.' },
  { t: 'Troquelado', d: 'Microperforado entre formatos para separarlos a mano sin romperlos.' },
  { t: 'Papel', d: 'Bond 60 g para 1 copia, o autocopiativo químico para 2 y 3 copias.' },
  { t: 'Impresión', d: 'Matricial. Compatible con Epson LX-350, LX-300 y similares.' },
];

const documentos = [
  {
    t: 'Guías de remisión',
    d: 'Remitente y transportista. El documento físico más aceptado para sustentar traslados, en duplicado o triplicado.',
    url: '/guias-de-remision',
  },
  {
    t: 'Boletas y facturas de contingencia',
    d: 'Para cuando se cae el internet o el sistema de emisión electrónica. Llevan la leyenda legal obligatoria.',
    url: '/boletas-de-venta',
  },
  {
    t: 'Notas de crédito y débito',
    d: 'Para anular o modificar operaciones que necesitan respaldo físico continuo.',
    url: '/notas-de-credito-debito',
  },
  {
    t: 'Liquidaciones de compra',
    d: 'Compras a personas naturales sin RUC: acopio agrario, pesca artesanal y comercio de productos primarios.',
    url: '/liquidaciones-de-compra',
  },
];

const sectores = [
  'Transporte y logística',
  'Distribuidoras mayoristas',
  'Empresas agrarias y acopio',
  'Retail con despacho',
  'Constructoras',
  'Minería',
];

const faqs = [
  {
    q: '¿Los formatos continuos siguen siendo válidos ante SUNAT?',
    a: 'Sí. Las guías de remisión en papel continuo están vigentes, y las boletas y facturas físicas siguen siendo obligatorias cuando hay contingencia eléctrica o de internet. Cada formato se imprime con la estructura y las leyendas que exige el reglamento.',
  },
  {
    q: '¿Qué impresora necesito?',
    a: 'Una impresora matricial de arrastre por tractor de agujas. Las más comunes en Perú son la Epson LX-350 y la LX-300, pero trabajamos con cualquier equipo cuyo tractor acepte las medidas de la tabla. Si tienes dudas, escríbenos con el modelo y lo confirmamos.',
  },
  {
    q: '¿Qué es el papel autocopiativo y cuándo conviene?',
    a: 'Es un papel químico que transfiere la impresión de la aguja a las hojas de abajo, sin papel carbón. Conviene en cuanto necesitas un original y una o dos copias: se imprimen todas de una sola pasada, no una por una.',
  },
  {
    q: '¿Puedo pedirlo con mi logo y mis datos?',
    a: 'Sí, y está incluido. Adaptamos el formato a tu razón social, RUC, dirección, teléfonos y logo, respetando los casilleros y leyendas obligatorios de cada tipo de documento.',
  },
  {
    q: '¿Cuál es la cantidad mínima?',
    a: 'Trabajamos desde 1 millar en la mayoría de formatos continuos. En los que arrancan en 5 millares lo verás indicado en la tabla de precios, porque el montaje de la matriz obliga a un tiraje mayor.',
  },
  {
    q: '¿Cuánto tarda la entrega?',
    a: 'Entre 24 y 48 horas en Lima metropolitana, una vez aprobada la prueba de diseño. A provincia enviamos por courier y el tiempo depende del destino.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Impresión de formatos continuos autorizados SUNAT',
    description:
      'Impresión de formatos continuos en papel bond o autocopiativo para impresoras matriciales: guías de remisión, boletas y facturas de contingencia, notas de crédito y liquidaciones de compra.',
    serviceType: 'Impresión de formatos continuos',
    areaServed: { '@type': 'City', name: 'Lima' },
    provider: {
      '@type': 'LocalBusiness',
      name: 'Formatos Intergráficos',
      url: base,
      telephone: '+51910500706',
    },
    url: `${base}/servicios/formatos-continuos`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Formatos continuos', item: `${base}/servicios/formatos-continuos` },
    ],
  },
];
---

<Layout
  title="Formatos Continuos SUNAT en Lima | Papel Matricial a Medida"
  description="Imprimimos formatos continuos autorizados por SUNAT: guías de remisión, boletas de contingencia y liquidaciones. Papel bond o autocopiativo, desde 1 millar."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <div class="fi-site fc">
    <Header />

    <main>
      <!-- HERO -->
      <section class="fc-hero">
        <div class="fc-hero__rail" aria-hidden="true"></div>
        <div class="fi-wrap fc-hero__inner">
          <div class="fc-hero__texto">
            <nav class="fc-bc" aria-label="Ruta de navegación">
              <a href="/">Inicio</a> <span aria-hidden="true">›</span>
              <span aria-current="page">Formatos continuos</span>
            </nav>
            <h1 class="fc-h1">Formatos continuos autorizados SUNAT en Lima</h1>
            <p class="fc-hero__lead">
              Papel bond o autocopiativo con perforación lateral, para impresoras matriciales.
              Guías de remisión, comprobantes de contingencia y liquidaciones de compra, con tu
              logo y tus datos.
            </p>
            <div class="fc-hero__acciones">
              <a class="fc-btn" href={WHATSAPP} target="_blank" rel="noopener noreferrer" data-wa="continuos-hero">
                Cotizar por WhatsApp
              </a>
              <a class="fc-btn fc-btn--linea" href="/precios">Ver precios por millar</a>
            </div>
            <p class="fc-hero__nota">Desde 1 millar · Prueba de diseño incluida · Entrega en 24–48 h</p>
          </div>

          <div class="fc-hero__figura">
            <Documento
              tipo="Guía de remisión remitente"
              numero="T001 - 000412"
              acento="#C62F44"
              acentoTexto="#FFFFFF"
              suave="#F6E7EA"
              continuo={true}
              copias={['#F7C7CF', '#FBE7A6']}
              campos={['Destinatario', 'R.U.C.', 'Punto de partida', 'Punto de llegada']}
              destino="Destinatario"
            />
          </div>
        </div>
      </section>

      <!-- QUÉ ES -->
      <section class="fi-section fc-sec fc-sec--paper">
        <div class="fi-wrap fc-quees">
          <div class="fc-quees__texto">
            <h2 class="fi-h2 fc-h2">Qué es el papel continuo</h2>
            <p>
              Una sola hoja sin fin, con agujeros a los dos lados, que el tractor de una impresora
              matricial arrastra hoja por hoja. Se imprime de corrido, sin cambiar de papel y sin
              detenerse entre documento y documento: por eso es el formato de las operaciones que
              van en serie, como un día de despachos o una jornada de facturación.
            </p>
            <p>
              Su ventaja real aparece con las copias. En papel autocopiativo, una sola pasada de la
              aguja imprime el original y las dos copias de abajo. No hay que imprimir tres veces ni
              intercalar papel carbón, que es donde se pierden las horas y donde salen los errores
              de alineación.
            </p>
          </div>

          <ul class="fc-especs">
            {
              especificaciones.map((e) => (
                <li class="fc-espec">
                  <strong>{e.t}</strong>
                  <span>{e.d}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- MEDIDAS -->
      <section class="fi-section fc-sec">
        <div class="fi-wrap">
          <h2 class="fi-h2 fc-h2">Medidas que manejamos</h2>
          <p class="fc-sec__intro">
            Las mismas tres medidas de nuestra lista de precios. Si tu formato no está aquí,
            escríbenos: se puede fabricar a medida.
          </p>

          <div class="fc-tabla__scroll">
            <table class="fc-tabla">
              <thead>
                <tr>
                  <th scope="col">Formato</th>
                  <th scope="col">Medida</th>
                  <th scope="col">Copias</th>
                  <th scope="col">Para qué se usa</th>
                </tr>
              </thead>
              <tbody>
                {
                  medidas.map((m) => (
                    <tr>
                      <th scope="row">{m.formato}</th>
                      <td class="fc-tabla__mono">{m.medida}</td>
                      <td>{m.copias}</td>
                      <td class="fc-tabla__uso">{m.uso}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- QUÉ DOCUMENTOS -->
      <section class="fi-section fc-sec fc-sec--paper">
        <div class="fi-wrap">
          <h2 class="fi-h2 fc-h2">Qué imprimimos en continuo</h2>
          <div class="fc-docs">
            {
              documentos.map((d) => (
                <a class="fc-doc" href={d.url}>
                  <h3>{d.t}</h3>
                  <p>{d.d}</p>
                  <span class="fc-doc__mas">Ver el formato →</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- SECTORES -->
      <section class="fi-section fc-sec">
        <div class="fi-wrap fc-quien">
          <h2 class="fi-h2 fc-h2">Quién trabaja en continuo</h2>
          <p class="fc-sec__intro">
            Cualquier negocio que emita documentos en serie y necesite copias físicas en el
            momento. Estos son los que más nos lo piden:
          </p>
          <ul class="fc-chips">
            {sectores.map((s) => <li class="fc-chip">{s}</li>)}
          </ul>
        </div>
      </section>

      <!-- FAQ -->
      <section class="fi-section fc-sec fc-sec--paper fi-faq">
        <div class="fi-narrow fc-faq">
          <h2 class="fi-h2 fc-h2">Preguntas sobre formatos continuos</h2>
          <div>
            {
              faqs.map((f) => (
                <details class="fc-faq__item">
                  <summary>
                    <h3>{f.q}</h3>
                    <span class="fi-faq-plus" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
          <a
            class="fc-cta"
            href={WHATSAPP}
            target="_blank"
            rel="noopener noreferrer"
            data-wa="continuos-faq"
          >
            Cotizar formatos continuos por WhatsApp
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  /* ==========================================================================
     RIEL PERFORADO — la firma visual de esta página.
     Reproduce el borde del papel continuo: una tira de agujeros que recorre todo
     el hero. Solo en escritorio; en móvil se oculta para no robar ancho.
     ========================================================================== */
  .fc-hero {
    position: relative;
    background: var(--fi-carbon);
    color: var(--fi-texto-claro);
    overflow: hidden;
    padding: 56px clamp(16px, 4vw, 64px) 96px;
  }
  .fc-hero__rail {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40px;
    border-right: 1px solid var(--fi-borde-oscuro);
    background-image: radial-gradient(circle, var(--fi-borde-oscuro-2) 3px, transparent 3.5px);
    background-size: 40px 40px;
    background-position: 50% 20px;
    pointer-events: none;
  }
  .fc-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-left: 40px;
  }
  .fc-bc {
    font-size: 14px;
    color: var(--fi-texto-apagado);
    margin-bottom: 24px;
  }
  .fc-bc a {
    color: var(--fi-texto-apagado);
  }
  .fc-h1 {
    margin: 0 0 24px;
    font-family: var(--fi-display);
    font-weight: 900;
    font-size: clamp(40px, 5.2vw, 76px);
    line-height: 0.92;
    text-transform: uppercase;
  }
  .fc-hero__lead {
    margin: 0 0 32px;
    max-width: 56ch;
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.6;
    color: var(--fi-texto-claro-2);
  }
  .fc-hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .fc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 26px;
    background: var(--fi-rojo);
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
  }
  .fc-btn:hover {
    background: var(--fi-rojo-oscuro);
  }
  .fc-btn--linea {
    background: transparent;
    border: 1px solid var(--fi-borde-oscuro-2);
    color: var(--fi-texto-claro);
  }
  .fc-btn--linea:hover {
    background: var(--fi-carbon-3);
    border-color: var(--fi-papel);
  }
  .fc-hero__nota {
    margin: 24px 0 0;
    font-size: 14px;
    color: var(--fi-texto-apagado);
  }
  .fc-hero__figura {
    display: flex;
    justify-content: center;
  }

  /* --- Secciones ---
     Las dos variantes declaran fondo Y color. Sin el `color` en la de papel, el
     texto heredaba el claro de `.fi-site` y los títulos quedaban INVISIBLES sobre
     el fondo papel (mismo valor rgb en texto y fondo). */
  .fc-sec {
    background: var(--fi-carbon);
    color: var(--fi-texto-claro);
  }
  .fc-sec--paper {
    background: var(--fi-papel);
    color: var(--fi-texto-oscuro);
  }
  .fc-h2 {
    margin-bottom: 28px;
  }
  .fc-sec__intro {
    max-width: 62ch;
    margin: 0 0 36px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--fi-texto-apagado);
  }
  .fc-sec--paper .fc-sec__intro {
    color: var(--fi-texto-oscuro-2);
  }
  .fc-quees {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .fc-quees__texto p {
    margin: 0 0 20px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--fi-texto-oscuro-2);
  }
  .fc-especs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--fi-borde-claro);
  }
  .fc-espec {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid var(--fi-borde-claro);
  }
  .fc-espec strong {
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .fc-espec span {
    font-size: 16px;
    line-height: 1.6;
    color: var(--fi-texto-oscuro-2);
  }

  /* --- Tabla técnica --- */
  .fc-tabla__scroll {
    overflow-x: auto;
  }
  .fc-tabla {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 16px;
  }
  .fc-tabla th,
  .fc-tabla td {
    text-align: left;
    padding: 20px 20px 20px 0;
    border-bottom: 1px solid var(--fi-borde-oscuro);
  }
  .fc-tabla thead th {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fi-texto-apagado);
    border-bottom-color: var(--fi-borde-oscuro-2);
  }
  .fc-tabla tbody th {
    font-weight: 700;
  }
  .fc-tabla__mono {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .fc-tabla__uso {
    color: var(--fi-texto-apagado);
  }

  /* --- Tarjetas de documento --- */
  .fc-docs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--fi-borde-claro);
    border: 1px solid var(--fi-borde-claro);
  }
  .fc-doc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 32px 28px;
    background: var(--fi-papel);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .fc-doc:hover {
    background: var(--fi-papel-2);
  }
  .fc-doc h3 {
    margin: 0;
    font-family: var(--fi-display);
    font-weight: 800;
    font-size: 26px;
    line-height: 1;
    text-transform: uppercase;
  }
  .fc-doc p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--fi-texto-oscuro-2);
  }
  .fc-doc__mas {
    margin-top: auto;
    font-size: 14px;
    font-weight: 700;
    color: var(--fi-rojo);
  }

  /* --- Chips de sector --- */
  .fc-quien {
    max-width: 900px;
  }
  .fc-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fc-chip {
    padding: 10px 18px;
    border: 1px solid var(--fi-borde-oscuro-2);
    font-size: 15px;
    color: var(--fi-texto-claro-2);
  }

  /* --- FAQ --- */
  .fc-faq h2 {
    margin-bottom: 32px;
  }
  .fc-faq__item {
    border-bottom: 1px solid var(--fi-borde-claro);
  }
  .fc-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
  }
  .fc-faq__item summary h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }
  .fc-faq__item p {
    margin: 0;
    padding: 0 0 22px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--fi-texto-oscuro-2);
  }
  .fc-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    margin-top: 36px;
    padding: 0 30px;
    background: var(--fi-rojo);
    color: #fff !important;
    font-weight: 700;
    text-decoration: none;
  }
  .fc-cta:hover {
    background: var(--fi-rojo-oscuro);
  }

  /* --- Móvil (todo añadido: el canvas no traía media queries) --- */
  @media (max-width: 900px) {
    .fc-hero__inner,
    .fc-quees {
      grid-template-columns: 1fr;
    }
    .fc-hero__figura {
      order: -1;
    }
    .fc-hero__rail {
      width: 22px;
      background-size: 22px 22px;
      background-position: 50% 12px;
    }
    .fc-hero__inner {
      padding-left: 22px;
    }
  }
  @media (max-width: 600px) {
    .fc-hero {
      padding-bottom: 64px;
    }
    .fc-btn,
    .fc-cta {
      width: 100%;
    }
    .fc-doc {
      padding: 26px 22px;
    }
  }
</style>
